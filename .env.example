# Random string you invent — Meta echoes it back during webhook setup
# to prove you own the endpoint. Anything works, e.g. "my-super-secret-123"
WHATSAPP_VERIFY_TOKEN=

# From Meta App Dashboard → your app → WhatsApp → API Setup → Phone Number ID.
# A long numeric string identifying the WhatsApp Business number that sends replies.
WHATSAPP_PHONE_NUMBER_ID=

# From Meta App Dashboard → your app → WhatsApp → API Setup → "Access Token".
# System User token with whatsapp_business_messaging permission. Never commit this.
WHATSAPP_ACCESS_TOKEN=

# From https://console.groq.com/keys. Free tier works fine for prototyping.
# Used by the agent (src/lib/server/agent.ts) to generate chat replies via Groq.
GROQ_API_KEY=

# Optional. Redis connection string (redis:// or rediss:// for TLS).
# If set, per-user conversation memory is stored in Redis (survives restarts,
# works across instances). If unset, memory falls back to an in-process Map
# that is wiped on every restart.
# On Railway, the Redis plugin auto-injects this as REDIS_URL on the app service.
REDIS_URL=